{
  "name": "psr-success-comment",
  "version": "1.0.0",
  "description": "GitHub Action that comments on and labels the pull requests and issues resolved by a python-semantic-release release.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tpn --ci --no-spinner",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-exclude=\"src/index.ts\" --test-coverage-lines=95 --test-coverage-functions=95 --test-coverage-branches=90 test/*.test.ts",
    "check": "npm run typecheck && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "issue-parser": "^7.0.2"
  },
  "devDependencies": {
    "@types/issue-parser": "^3.0.5",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "third-party-notices": "^0.1.0",
    "typescript": "^7.0.2"
  }
}
